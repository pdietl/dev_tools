# Installed to ~/.config/systemd/user/ by dev_tools/provision
# (dotfiles/google-drive-ocamlfuse.service) and enabled via the
# default.target.wants symlink provision creates next to it.
# Keeps ~/GoogleDrive mounted with the google-drive-ocamlfuse that provision
# builds from upstream. Inert until the one-time OAuth setup has been done
# (ConditionPathExists below; provision prints the recipe at the end of a run).
# The suspend guard (system/suspend/gdfuse-suspend-guard) restarts this unit
# by name after aborting a stalled FUSE connection -- keep the name stable.
# Revert: systemctl --user disable --now google-drive-ocamlfuse.service,
# then delete this file and the wants symlink.

[Unit]
Description=Google Drive FUSE mount at %h/GoogleDrive
# Written by the one-time headless OAuth flow; until it exists the unit is
# skipped (condition), not failed.
ConditionPathExists=%h/.gdfuse/default/state

[Service]
Type=exec
# Clear any stale mount left by a crash ("transport endpoint is not
# connected"), then make sure the mountpoint exists.
ExecStartPre=-/usr/bin/fusermount3 -uz %h/GoogleDrive
ExecStartPre=/usr/bin/mkdir -p %h/GoogleDrive
# gdfuse >= 0.9 always runs in the foreground (libfuse -f is hardwired).
# -verbose records every Drive operation as a BEGIN/END pair, which is what
# identifies a request the daemon stopped answering. Deliberately not -debug:
# that adds curl wire tracing, which writes OAuth Authorization headers into a
# plaintext log. "-log_to -" is stdout: -verbose alone writes the trace to
# gdfuse's own log file instead, and that file is truncated on every start.
ExecStart=/usr/local/bin/google-drive-ocamlfuse -label default -verbose -log_to - %h/GoogleDrive
# Pay the cold getattr on the Drive root here rather than leaving it to
# whatever first stats $HOME after login. systemd-run keeps it off this unit's
# critical path: the suspend guard restarts this unit from a system-sleep
# hook, where blocking would delay resume.
ExecStartPost=-/usr/bin/systemd-run --user --quiet --collect --unit=gdfuse-prewarm /usr/local/bin/gdfuse-prewarm %h/GoogleDrive
ExecStop=/usr/bin/fusermount3 -u %h/GoogleDrive
# Remounts after a crash and after the suspend guard aborts a stalled
# connection pre-sleep. 10 s spacing keeps the default start-rate limit
# (5 starts / 10 s) from ever tripping while the network is down.
Restart=always
RestartSec=10
# Keep the trace out of the journal, whose per-service rate limit drops exactly
# the burst worth having. append: also makes the record survive a restart, which
# writing to a file directly does not: gdfuse truncates whatever log file it
# opens, so Restart=always and the suspend guard's restart would each erase the
# record of what preceded them. O_APPEND is also what makes copytruncate safe.
# The target directory must already exist (provision creates it): systemd wires
# up stdout before ExecStartPre runs, so append: into a missing directory fails
# the unit. Size-capped rotation lives in /etc/logrotate.d/gdfuse.
StandardOutput=append:%h/.local/state/gdfuse/gdfuse.log
StandardError=append:%h/.local/state/gdfuse/gdfuse.log

[Install]
WantedBy=default.target
