#!/bin/bash
# Keep /usr/local/share/applications/google-chrome.desktop derived from the
# packaged Chrome desktop entry, with the VA-API launch flag added.
#
# Chrome ships the VaapiOnNvidiaGPUs feature disabled, which switches off
# VA-API decode on NVIDIA entirely, and Chrome has no software HEVC decoder,
# so without the flag H.265 does not play at all. Adding a flag to a desktop
# launch means shadowing the whole entry: Chrome reads no flags file, and XDG
# desktop entries have no merge semantics.
#
# The shadow copy wins over the packaged file for every user, so it has to
# track that file rather than whatever it held when provision last ran. A
# Chrome release that adds a key otherwise leaves the winning copy without it,
# and a key missing there can break behaviour nothing to do with VA-API.
#
# Installed to /usr/local/sbin by dev_tools/provision, which also installs the
# apt hook that runs this after every dpkg transaction.
# Revert: rm /etc/apt/apt.conf.d/53chrome-vaapi-override, this script, and
# /usr/local/share/applications/google-chrome.desktop, then
# update-desktop-database /usr/local/share/applications

set -eEu
set -o pipefail

declare -r SRC=/usr/share/applications/google-chrome.desktop
declare -r OVERRIDE=/usr/local/share/applications/google-chrome.desktop
declare -r FLAG=--enable-features=VaapiOnNvidiaGPUs

if [ ! -e "$SRC" ]; then
    # Chrome is not installed; the shadow copy would advertise a launcher for
    # a binary that is not there.
    if [ -e "$OVERRIDE" ]; then
        rm -f "$OVERRIDE"
        update-desktop-database "$(dirname "$OVERRIDE")" 2> /dev/null || true
        echo "chrome-vaapi: Chrome not installed, removed $OVERRIDE"
    fi
    exit 0
fi

declare -r HEADER="\
# Generated by regenerate-chrome-vaapi-override from $SRC.
# Do not edit: every dpkg transaction rewrites this file.
# Chrome ships VaapiOnNvidiaGPUs disabled, which turns off VA-API decode on
# NVIDIA GPUs; without it H.265 does not play at all, as Chrome has no
# software HEVC decoder. /usr/local/share precedes /usr/share in
# XDG_DATA_DIRS, so this copy wins for every user. Only desktop-file launches
# carry the flag, not 'google-chrome' typed at a shell.
# Revert: rm /etc/apt/apt.conf.d/53chrome-vaapi-override and this file, then
# update-desktop-database /usr/local/share/applications"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

printf '%s\n' "$HEADER" > "$work"/new
sed "s|^Exec=/usr/bin/google-chrome-stable|& $FLAG|" "$SRC" >> "$work"/new
tail -n +"$(($(printf '%s\n' "$HEADER" | wc -l) + 1))" "$work"/new > "$work"/body

# Two assertions, because each catches what the other cannot. The count
# catches a release this sed no longer matches: a renamed binary path flags
# nothing, and a new Desktop Action flags all but the new entry. The
# comparison catches the reverse -- a copy differing from the source by
# anything besides the flag, which is how a key the release added goes
# missing from the file that wins.
exec_total=$(grep -c '^Exec=' "$SRC" || true)
exec_flagged=$(grep -c "^Exec=.*$FLAG" "$work"/body || true)
if [ "$exec_flagged" -ne "$exec_total" ]; then
    echo "chrome-vaapi: only $exec_flagged of $exec_total Exec lines would carry" >&2
    echo "chrome-vaapi: $FLAG. Chrome's desktop file no longer matches the Exec=" >&2
    echo "chrome-vaapi: pattern this script rewrites. $OVERRIDE left unchanged." >&2
    exit 1
fi
if ! sed "s| $FLAG||" "$work"/body | diff -q - "$SRC" > /dev/null; then
    echo "chrome-vaapi: the generated copy differs from $SRC by more than" >&2
    echo "chrome-vaapi: $FLAG. $OVERRIDE left unchanged." >&2
    exit 1
fi

if cmp -s "$work"/new "$OVERRIDE"; then
    exit 0
fi

mkdir -p "$(dirname "$OVERRIDE")"
install -m 0644 -o root -g root "$work"/new "$OVERRIDE"
update-desktop-database "$(dirname "$OVERRIDE")" 2> /dev/null || true
echo "chrome-vaapi: regenerated $OVERRIDE ($exec_flagged/$exec_total Exec lines flagged)"
