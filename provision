)

_apt_get install -y "${packages[@]}"

# =============================================================================
banner "Installing additional tools"
# =============================================================================

if command -v starship > /dev/null; then
    echo "  Starship: already installed"
else
    echo "  Starship: installing..."
    sh <(curl -sS https://starship.rs/install.sh) -y
fi

if in_wsl; then
    echo "  Google Chrome: skipped (WSL)"
elif command -v google-chrome-stable > /dev/null; then
    echo "  Google Chrome: already installed"
else
    echo "  Google Chrome: installing..."
    _wget -O /tmp/google-chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
    _apt_get install -y /tmp/google-chrome.deb
    rm /tmp/google-chrome.deb
fi

if in_wsl; then
    echo "  1Password: skipped (WSL)"
elif command -v 1password > /dev/null; then
    echo "  1Password: already installed"
else
    echo "  1Password: installing..."
    _wget -O /tmp/1password.deb https://downloads.1password.com/linux/debian/amd64/stable/1password-latest.deb
    _apt_get install -y /tmp/1password.deb
    rm /tmp/1password.deb
fi

if in_wsl; then
    echo "  Slack: skipped (WSL)"
elif command -v slack > /dev/null; then
    echo "  Slack: already installed"
else
    echo "  Slack: installing..."
    slack_page=$(curl -fsS https://slack.com/release-notes/linux) || true
    slack_ver=$(grep -oP 'Slack \K[0-9]+\.[0-9]+\.[0-9]+' <<< "$slack_page" | head -1) || true
    if [ -z "$slack_ver" ]; then
        echo "Error determining latest Slack version!"
        exit 1
    fi
    echo "  Slack: latest is $slack_ver"
    _wget -O /tmp/slack.deb "https://downloads.slack-edge.com/desktop-releases/linux/x64/${slack_ver}/slack-desktop-${slack_ver}-amd64.deb"
    _apt_get install -y /tmp/slack.deb
    rm /tmp/slack.deb
fi

if in_wsl; then
    echo "  Saleae Logic2: skipped (WSL)"
elif pkg_installed saleae-logic2; then
    echo "  Saleae Logic2: already installed"
else
    echo "  Saleae Logic2: installing..."
    tmp=$(mktemp -d)
    git clone https://github.com/pdietl/saleae-logic2-appimage-to-deb.git "$tmp"
    pushd "$tmp" > /dev/null
    ./build-logic2-deb.sh
    deb_file=$(ls -1 "$tmp"/saleae-logic2_*.deb 2> /dev/null | head -1)
    if [ -n "$deb_file" ]; then
        _apt_get install -y "$deb_file"
        rm "$deb_file"
    else
        echo "Error: Saleae deb file not found!"
        exit 1
    fi
    popd > /dev/null
    rm -rf "$tmp"
fi

if in_wsl; then
    echo "  KiCad: skipped (WSL)"
elif pkg_installed kicad; then
    echo "  KiCad: already installed"
else
    echo "  KiCad: building from source (30-50 min)..."
    if ! pipx_out=$(sudo -u "$SUDO_USER" -- pipx install west 2>&1); then
        echo "Error: pipx install west failed:" >&2
        echo "$pipx_out" >&2
        exit 1
    fi
    kicad_repo=$USER_HOME/Repos/kicad-source-to-deb
    # A .deb left behind by an earlier failed run would otherwise sit next to
    # this run's output; with two versions present the post-build glob below
    # matches both and `apt-get install` errors on the ambiguity.
    rm -f "$kicad_repo"/kicad*_*.deb
    # Everything below runs as the invoking user, so the clone and the several
    # GB of build tree it produces are owned by them without a chown after the
    # fact -- one over ~/Repos would recurse into every unrelated checkout
    # there. pipx puts `west` in ~/.local/bin, which sudo's secure_path
    # excludes, so it is prepended for the build script's own west calls; the
    # script bootstraps its workspace under the repo's gitignored work/, so
    # there is no west init/update to do out here.
    sudo -H -u "$SUDO_USER" bash -ec '
        export PATH="$HOME/.local/bin:$PATH"
        mkdir -p "$HOME/Repos"
        cd "$HOME/Repos"
        [ -d kicad-source-to-deb ] ||
            git clone https://github.com/pdietl/kicad-source-to-deb.git
        cd kicad-source-to-deb
        ./build-kicad-deb.sh
    '
    kicad_deb=$(ls -1 "$kicad_repo"/kicad_*.deb 2> /dev/null || true)
    models_deb=$(ls -1 "$kicad_repo"/kicad-packages3d_*.deb 2> /dev/null || true)
    if [ -z "$kicad_deb" ] || [ -z "$models_deb" ]; then
        echo "Error: KiCad deb files not found!"
        exit 1
    fi
    # kicad and kicad-packages3d are installed in one call on purpose. kicad
    # recommends kicad-packages3d at exactly its own version, so installing
    # kicad alone leaves that recommendation unsatisfied; naming both is what
    # makes the models come from this build rather than from nowhere.
    #
    # The build also produces kicad-dbgsym. It is deliberately not installed
    # (1.9 GB of debug info, useful only under a debugger) but it is kept on
    # disk: debug files match binaries by build ID, not version, so this .deb
    # is the only copy of the symbols for the build being installed here.
    # Investigating a later crash or hang is then one `apt install` away
    # instead of a 30-50 minute rebuild that would produce non-matching IDs.
    # shellcheck disable=SC2086
    _apt_get install -y $kicad_deb $models_deb
    # shellcheck disable=SC2086
    rm -f $kicad_deb $models_deb

    # /usr/local/bin precedes /usr/bin on PATH, so a KiCad installed there
    # from source keeps running and the package just installed never does --
    # with no error from apt or from KiCad to say so. Removing another
    # administrator's files under /usr/local is not this script's call, so
    # say it loudly and leave it to them.
    if [ -x /usr/local/bin/kicad ]; then
        echo "  KiCad: WARNING /usr/local/bin/kicad shadows the package on PATH; remove it" >&2
    fi

    # KiCad pins an absolute prefix into the per-user library table on first
    # run and never revisits it; a stale table yields an empty library list
    # with no error shown. The glob is safe if it matches nothing (fresh
    # machine, KiCad never launched): the -d guard skips the loop body, and
    # rm -f never creates anything, so no root-owned file is left behind.
    for tbl in "$USER_HOME"/.config/kicad/*/; do
        [ -d "$tbl" ] || continue
        rm -f "$tbl"/sym-lib-table "$tbl"/fp-lib-table "$tbl"/design-block-lib-table
    done
fi

if command -v aws > /dev/null; then
    echo "  awscli: already installed"
else
    echo "  awscli: installing..."
    tmp=$(mktemp -d)
    pushd "$tmp" > /dev/null
    curl -sS "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
    unzip -q awscliv2.zip
    ./aws/install
    popd > /dev/null
    rm -rf "$tmp"
fi

if [ -e "$USER_HOME/.nvm_installed" ]; then
    echo "  NVM + node: already installed"
else
    nvm_latest=$(curl -sS https://api.github.com/repos/nvm-sh/nvm/releases/latest | jq -r '.tag_name')
    if [ -z "$nvm_latest" ] || [ "$nvm_latest" = "null" ]; then
        echo "Error determining latest NVM version!"
        exit 1
    fi
    echo "  NVM $nvm_latest + node: installing..."
    sudo -u "$SUDO_USER" bash -c "curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/$nvm_latest/install.sh | bash"
    sudo -u "$SUDO_USER" bash -c "export NVM_DIR='$USER_HOME/.nvm' && source \"\$NVM_DIR/nvm.sh\" && nvm install node"
    touch "$USER_HOME/.nvm_installed"
    _chown "$SUDO_USER:$SUDO_USER" "$USER_HOME/.nvm_installed"
fi

if command -v nvim > /dev/null; then
    echo "  Neovim: already installed"
else
    echo "  Neovim: installing..."
    _wget -O /tmp/nvim.tgz https://github.com/neovim/neovim/releases/latest/download/nvim-linux-$(uname -m).tar.gz
    tar -C /usr/local --strip-components 1 -xzf /tmp/nvim.tgz
    rm /tmp/nvim.tgz
    installUser "$USER_HOME"/.config/nvim
    # nvim/. rather than nvim/*: the glob would skip dotfiles (.neoconf.json)
    _cp -r "$SCRIPT_DIR"/dotfiles/nvim/. "$USER_HOME"/.config/nvim
    _chown -R "$SUDO_USER":"$SUDO_USER" "$USER_HOME"/.config/nvim
fi

if [ -e "$USER_HOME"/.cargo/env ]; then
    echo "  Rust: already installed"
else
    echo "  Rust: installing..."
    sudo -u "$SUDO_USER" -- curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs |
        sudo -u "$SUDO_USER" -- sh -s -- -y --no-modify-path
fi
# Always ensure the cargo/rustup bin dir is on PATH, even if Rust was already installed
path_additions+=('"$HOME"/.cargo/bin')

if [ -e /usr/local/go ]; then
    echo "  Go: already installed"
else
    echo "  Go: installing..."
    latest=$(wget -nv -O- https://go.dev/dl/ 2> /dev/null)
    latest=$(grep -oP -m1 'go(\d+\.){3}linux-amd64\.tar\.gz' - <<< "$latest")
    if [ -z "$latest" ]; then
        echo "Error determining latest Go version!"
        exit 1
    fi
    _wget "https://go.dev/dl/$latest"
    rm -rf /usr/local/go
    tar -C /usr/local -xzf "$latest"
    # As the user: a root mkdir leaves ~/go root-owned and unwritable as GOPATH.
    sudo -u "$SUDO_USER" mkdir -p "$USER_HOME"/go/{bin,pkg,src}
    rm "$latest"
    echo "  Go: $(/usr/local/go/bin/go version)"
fi
# Always ensure the Go bin dirs are on PATH, even if Go was already installed
path_additions+=('/usr/local/go/bin' '"$GOPATH"/bin')

# Installs to "$HOME"/.local/bin, which $path_additions already covers.
if [ -x "$USER_HOME"/.local/bin/uv ]; then
    echo "  uv: already installed"
else
    echo "  uv: installing..."
    # UV_NO_MODIFY_PATH: this script owns PATH, so the installer must not
    # edit the shell profiles itself.
    sudo -u "$SUDO_USER" -- curl -LsSf https://astral.sh/uv/install.sh |
        sudo -u "$SUDO_USER" -- env UV_NO_MODIFY_PATH=1 sh
fi

if command -v bazelisk > /dev/null; then
    echo "  Bazelisk: already installed"
else
    arch=$(uname -m)
    case "$arch" in
    x86_64) arch="amd64" ;;
    aarch64) arch="arm64" ;;
    *)
        echo "Unsupported architecture: $arch"
        exit 1
        ;;
    esac
    latest=$(curl -sS https://api.github.com/repos/bazelbuild/bazelisk/releases/latest | jq -r '.tag_name')
    if [ -z "$latest" ] || [ "$latest" = "null" ]; then
        echo "Error determining latest Bazelisk version!"
        exit 1
    fi
    echo "  Bazelisk $latest: installing..."
    _wget -O /usr/local/bin/bazelisk "https://github.com/bazelbuild/bazelisk/releases/download/${latest}/bazelisk-linux-${arch}"
    chmod +x /usr/local/bin/bazelisk
    ln -sf /usr/local/bin/bazelisk /usr/local/bin/bazel
fi

if [ -e /etc/.nix-installed ]; then
    echo "  Nix: already installed"
else
    echo "  Nix: installing..."
    printf 'n\ny\n' | sh <(curl -L https://nixos.org/nix/install) --daemon 2>&1 | grep -E '^\~\~>|error|warning' | grep -v 'is greater than SYS_UID_MAX' || true
    echo "trusted-users = $SUDO_USER" >> /etc/nix/nix.conf
    touch /etc/.nix-installed
fi
# Converge the user-level nix.conf on every run so settings updates deploy.
installUser "$USER_HOME/.config/nix" "$SCRIPT_DIR/dotfiles/nix.conf"

if in_wsl; then
    echo "  Nerd Font: skipped (WSL)"
elif [ -e "$USER_HOME/.fonts/0xProtoNerdFontMono-Regular.ttf" ]; then
    echo "  Nerd Font: already installed"
else
    nerdfont_latest=$(curl -sS https://api.github.com/repos/ryanoasis/nerd-fonts/releases/latest | jq -r '.tag_name')
    if [ -z "$nerdfont_latest" ] || [ "$nerdfont_latest" = "null" ]; then
        echo "Error determining latest Nerd Font version!"
        exit 1
    fi
    echo "  0xProto Nerd Font $nerdfont_latest: installing..."
    _wget -O /tmp/nerdfont.zip "https://github.com/ryanoasis/nerd-fonts/releases/download/${nerdfont_latest}/0xProto.zip"
    _mkdir -p "$USER_HOME"/.fonts
    aunpack --extract-to "$USER_HOME"/.fonts /tmp/nerdfont.zip
    rm /tmp/nerdfont.zip
    rm "$USER_HOME"/.fonts/{LICENSE,README.md}
    _chown "$SUDO_USER:$SUDO_USER" -R "$USER_HOME"/.fonts
fi

# =============================================================================
banner "Setting up Docker"
# =============================================================================

systemctl is-active --quiet docker || sleep 5
add_user_to_group "$SUDO_USER" docker
echo "  Sanity check as '$SUDO_USER'..."
if ! su -c 'docker run hello-world' "$SUDO_USER" > /dev/null 2>&1; then
    echo "ERROR: Docker is misconfigured. Please contact a human for help."
    exit 1
fi
echo "  Docker: OK"

# =============================================================================
banner "Configuring system"
# =============================================================================

echo "  Sudoers: passwordless sudo"
sed -i 's/^%sudo.*/%sudo ALL=NOPASSWD: ALL/' /etc/sudoers

if [ -e "/home/$SUDO_USER/.vimrc" ]; then
    echo "  vimrc: already installed"
else
    echo "  vimrc: installing"
    _cp "$SCRIPT_DIR"/dotfiles/vimrc "$USER_HOME"/.vimrc
    _chown "$SUDO_USER":"$SUDO_USER" "$USER_HOME"/.vimrc
    installUser "$USER_HOME"/.vim/pack/plugins/start/cscope/plugin/ "$SCRIPT_DIR"/dotfiles/cscope_maps.vim
    installUser "$USER_HOME"/.vim/spell
fi

if [ -e "/home/$SUDO_USER/.tmux.conf" ]; then
    echo "  tmux.conf: already installed"
else
    echo "  tmux.conf: installing"
    _cp "$SCRIPT_DIR"/dotfiles/tmux.conf "$USER_HOME"/.tmux.conf
    _chown "$SUDO_USER":"$SUDO_USER" "$USER_HOME"/.tmux.conf
fi

echo "  Cleaning up home directories..."
rm -rf "$USER_HOME"/{Public,Templates,Music}
declare -a dir_list=(
    "$USER_HOME"/Applications
    "$USER_HOME"/Downloads
    "$USER_HOME"/GoogleDrive
    "$USER_HOME"/Learn
    "$USER_HOME"/Repos
)
# A mountpoint belongs to whatever mounted it. google-drive-ocamlfuse mounts
# without allow_other, so root cannot even stat ~/GoogleDrive, and the
# recursive chown below would otherwise walk the whole remote filesystem. The
# directory still has to be created on a machine where nothing has mounted it
# yet. findmnt answers from /proc/self/mountinfo; mountpoint(1) stats the path
# and so fails on exactly the mounts this needs to detect.
declare -a own_dirs=()
for dir in "${dir_list[@]}"; do
    if findmnt -rno TARGET --mountpoint "$dir" > /dev/null 2>&1; then
        echo "  ${dir#"$USER_HOME"/}: mounted, left to its mounter"
    else
        own_dirs+=("$dir")
    fi
done
# Created as the user, so there is no root-owned directory to repair
# afterwards. A root mkdir needs a chown, and a recursive one walks every
# checkout under ~/Repos -- tens of thousands of inodes, including build trees
# -- to correct at most the single directory it had just created. provision
# promises these directories, not their contents; the non-recursive chown keeps
# that promise for one an earlier run left owned by root, and claims nothing
# below it.
if [ ${#own_dirs[@]} -gt 0 ]; then
