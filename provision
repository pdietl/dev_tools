declare -r GDFUSE_VERSION=v0.9.1

# =============================================================================
banner "google-drive-ocamlfuse (upstream $GDFUSE_VERSION source build)"
# =============================================================================

# Built from the upstream release tag instead of the PPA deb: the
# non-blocking-statfs fix (upstream issue #896 / PR #943, ours) landed in
# v0.9.1, but the PPA still ships 0.9.0, which blocks. A blocking statfs
# leaves df, GTK file choosers, and some PAM stacks in uninterruptible
# D-state whenever Drive or the network stalls, which also wedges suspend
# (the kernel freezer cannot freeze D-state tasks). Once the PPA or the
# archive ships >= 0.9.1, this section can go back to the deb; then remove
# $GDFUSE_BIN and the stamp file.
declare -r GDFUSE_REPO=https://github.com/astrada/google-drive-ocamlfuse
declare -r GDFUSE_COMMIT=67f87d0cd4cc3c8d294f7e97f94ec5249fb00fc9 # = $GDFUSE_VERSION
declare -r GDFUSE_BIN=/usr/local/bin/google-drive-ocamlfuse
declare -r GDFUSE_STAMP=/usr/local/share/google-drive-ocamlfuse.commit
declare -r GDFUSE_UNIT=google-drive-ocamlfuse.service
declare -r GDFUSE_PREWARM=/usr/local/bin/gdfuse-prewarm

if [ -x "$GDFUSE_BIN" ] && [ "$(cat "$GDFUSE_STAMP" 2> /dev/null || true)" = "$GDFUSE_COMMIT" ]; then
    echo "  $GDFUSE_BIN already built from $GDFUSE_VERSION ($GDFUSE_COMMIT)"
else
    echo "  Building $GDFUSE_VERSION ($GDFUSE_COMMIT) (as $SUDO_USER, opam switch 'gdfuse')..."
    gdfuse_build_dir=$(sudo -u "$SUDO_USER" mktemp -d /tmp/gdfuse-build.XXXXXX)
    sudo -H -u "$SUDO_USER" env OPAMYES=1 bash -ec "
        git clone -q '$GDFUSE_REPO' '$gdfuse_build_dir/src'
        git -C '$gdfuse_build_dir/src' checkout -q '$GDFUSE_COMMIT'
        cd '$gdfuse_build_dir/src'
        [ -d \"\$HOME/.opam\" ] || opam init --bare -n > /dev/null
        opam switch list -s 2> /dev/null | grep -qx gdfuse ||
            opam switch create gdfuse ocaml-system
        eval \"\$(opam env --switch=gdfuse --set-switch)\"
        # --assume-depexts: ocurl's depext metadata wants libcurl4-gnutls-dev,
        # which conflicts with the libcurl4-openssl-dev the package list
        # installs. The headers/curl-config are equivalent for building ocurl
        # (only the runtime TLS backend differs), and every real system dep
        # (libfuse3-dev, libsqlite3-dev, libgmp-dev, zlib1g-dev, pkg-config)
        # is in the apt package list, so skip opam's depext handling instead
        # of letting it flip the curl dev package back and forth.
        opam install --deps-only --assume-depexts .
        dune build --profile release bin/gdfuse.exe
    "
    _install -m 0755 "$gdfuse_build_dir/src/_build/default/bin/gdfuse.exe" "$GDFUSE_BIN"
    echo "$GDFUSE_COMMIT" > "$GDFUSE_STAMP"
    rm -rf "$gdfuse_build_dir"
    echo "  NOTE: if the mount was active, restart it to pick up the new binary:"
    echo "        systemctl --user restart $GDFUSE_UNIT"
fi

# This build replaces the deb; remove it only after the build succeeded
# so a failed build doesn't leave the machine with no gdfuse binary at all.
if dpkg -s google-drive-ocamlfuse > /dev/null 2>&1; then
    echo "  Removing the PPA deb (superseded by $GDFUSE_BIN)"
    _apt_get remove -y google-drive-ocamlfuse
fi
if ls /etc/apt/sources.list.d/*alessandro-strada* > /dev/null 2>&1; then
    add-apt-repository --remove --no-update -y ppa:alessandro-strada/ppa > /dev/null 2>&1
fi

# Warms the mount so the first process to list $HOME does not wait on a cold
# getattr; the unit's ExecStartPost runs it detached. Installed before the
# unit so a fresh machine never has a unit referring to a missing binary.
_install -m 0755 "$SCRIPT_DIR"/system/gdfuse/gdfuse-prewarm "$GDFUSE_PREWARM"
echo "  Mount prewarm: installed $GDFUSE_PREWARM"

# Auto-mount: a user unit keeps ~/GoogleDrive mounted from login on. The
# suspend guard installed below restarts this exact unit name after aborting
# a stalled FUSE connection, and the unit's Restart=always remounts after
# crashes. A ConditionPathExists keeps it inert until the one-time OAuth
# setup has been done (recipe printed at the end of the run).
gdfuse_unit_dir=$USER_HOME/.config/systemd/user
if cmp -s "$SCRIPT_DIR/dotfiles/$GDFUSE_UNIT" "$gdfuse_unit_dir/$GDFUSE_UNIT"; then
    echo "  User unit: already current"
else
    installUser "$gdfuse_unit_dir" "$SCRIPT_DIR/dotfiles/$GDFUSE_UNIT"
    echo "  User unit: installed $GDFUSE_UNIT"
fi
# Enable without needing the user's session bus: create the same symlink
# `systemctl --user enable` would.
installUser "$gdfuse_unit_dir/default.target.wants"
ln -sfn "../$GDFUSE_UNIT" "$gdfuse_unit_dir/default.target.wants/$GDFUSE_UNIT"
_chown -h "$SUDO_USER":"$SUDO_USER" "$gdfuse_unit_dir/default.target.wants/$GDFUSE_UNIT"
# Pick up unit changes now if a session is running; start is a condition-skip
# no-op until OAuth is set up, and a no-op if already mounted.
systemctl --user --machine="$SUDO_USER@.host" daemon-reload 2> /dev/null || true
systemctl --user --machine="$SUDO_USER@.host" start "$GDFUSE_UNIT" 2> /dev/null || true

# =============================================================================
banner "NVIDIA driver: hold from unattended-upgrades"
# =============================================================================

# A background unattended-upgrades bump of the NVIDIA stack leaves the running
# kernel module older than the freshly-installed userspace until the next
# reboot; on the P16 (Discrete mode, dGPU drives the panel) rebooting out of
# that half-upgraded state wedged in the GPU teardown path and needed a hard
# power-off (2026-07-24). The drop-in blacklists the stack from the automatic
# path so it only moves during a deliberate `apt upgrade`. Inert without NVIDIA
# packages; interactive apt is unaffected. See
# thinkpad-p16-gen3-ubuntu-suspend.md.
if in_wsl; then
    echo "  NVIDIA unattended hold: skipped (WSL)"
else
    nvidia_hold_dest=/etc/apt/apt.conf.d/52nvidia-unattended-hold
    if cmp -s "$SCRIPT_DIR"/system/apt/52nvidia-unattended-hold "$nvidia_hold_dest"; then
        echo "  NVIDIA unattended hold: already current"
    else
        _install -m 0644 "$SCRIPT_DIR"/system/apt/52nvidia-unattended-hold "$nvidia_hold_dest"
        echo "  NVIDIA unattended hold: installed"
    fi
fi

# =============================================================================
banner "Chrome hardware video decode (HEVC via NVDEC)"
# =============================================================================

# Chrome has no software HEVC decoder, so H.265 video does not play at all
# unless VA-API hardware decode works. On an NVIDIA GPU that needs two
# pieces: the NVDEC VA-API driver, and a launch flag, because Chrome ships
# the VaapiOnNvidiaGPUs feature disabled and that switches off the whole
# VA-API path on NVIDIA. The packaged driver defaults to the direct (CUDA)
# backend, which is the one that survives Chrome's GPU sandbox, so no
# upstream source build is needed. Decode also requires a Wayland session
# and nvidia_drm.modeset=1 (set by the NVIDIA packaging's modprobe drop-in).
declare -r CHROME_OVERRIDE_SCRIPT=/usr/local/sbin/regenerate-chrome-vaapi-override
declare -r CHROME_OVERRIDE_HOOK=/etc/apt/apt.conf.d/53chrome-vaapi-override

# Gate on a real NVIDIA render node rather than on the machine model: the
# flag and the driver are both inert without one.
nvidia_render_node=
if ! in_wsl; then
    for node in /dev/dri/renderD*; do
        [ -e "$node" ] || continue
        if [ "$(cat "/sys/class/drm/${node##*/}/device/vendor" 2> /dev/null)" = 0x10de ]; then
            nvidia_render_node=$node
            break
        fi
    done
fi

if in_wsl; then
    echo "  Chrome VA-API: skipped (WSL)"
elif [ -z "$nvidia_render_node" ]; then
    echo "  Chrome VA-API: skipped (no NVIDIA render node in /dev/dri)"
else
    echo "  NVIDIA render node: $nvidia_render_node"
    _apt_get install -y nvidia-vaapi-driver vainfo

    # The override is a whole-file copy of a package-managed file, so it goes
    # stale when Chrome upgrades rather than when this script runs, and
    # nothing connects those two moments. One generator owns the flag and the
    # assertions; an apt hook re-runs it after every dpkg transaction and
    # provision is just another caller.
    _install -m 0755 "$SCRIPT_DIR"/system/chrome-vaapi/regenerate-chrome-vaapi-override \
        "$CHROME_OVERRIDE_SCRIPT"
    if cmp -s "$SCRIPT_DIR"/system/apt/53chrome-vaapi-override "$CHROME_OVERRIDE_HOOK"; then
        echo "  Chrome override apt hook: already current"
    else
        _install -m 0644 "$SCRIPT_DIR"/system/apt/53chrome-vaapi-override "$CHROME_OVERRIDE_HOOK"
        echo "  Chrome override apt hook: installed"
    fi
    "$CHROME_OVERRIDE_SCRIPT"

    # HEVC entrypoints are enumerated from the GPU at runtime, so this is the
    # only real check that decode is available; the backend name alone is not.
    vainfo_out=$(LIBVA_DRIVER_NAME=nvidia vainfo --display drm --device "$nvidia_render_node" 2>&1 || true)
    hevc_count=$(echo "$vainfo_out" | grep -c VAProfileHEVC || true)
    if echo "$vainfo_out" | grep -q '\[direct backend\]' && [ "$hevc_count" -gt 0 ]; then
        echo "  VA-API: direct backend, $hevc_count HEVC profiles"
    else
        # Only a warning: this describes the machine's current state rather
        # than a wrong assumption in this script, and every section below is
        # independent of it.
        echo "  WARNING: no usable HEVC decode on $nvidia_render_node -- wanted" >&2
        echo "           '[direct backend]' and at least one HEVC profile. Check that" >&2
        echo "           nvidia_drm.modeset=1 and rerun:" >&2
        echo "           LIBVA_DRIVER_NAME=nvidia vainfo --display drm --device $nvidia_render_node" >&2
    fi
fi

# =============================================================================
banner "Suspend mitigations"
# =============================================================================

if in_wsl; then
    echo "  Suspend mitigations: skipped (WSL)"
else
    # A FUSE filesystem whose daemon blocks on a dead network leaves callers
    # in unfreezable D-state, so every suspend attempt fails; applies to any
    # machine that mounts google-drive-ocamlfuse. A unit ordered against
    # sleep.target rather than a hook in /usr/lib/systemd/system-sleep, for
    # the ordering reasons the unit file gives.
    echo "  gdfuse suspend guard: installing"
    _install -m 0755 "$SCRIPT_DIR"/system/suspend/gdfuse-suspend-guard \
        /usr/local/sbin/gdfuse-suspend-guard
    _install -m 0644 "$SCRIPT_DIR"/system/suspend/gdfuse-suspend-guard.service \
        /etc/systemd/system/gdfuse-suspend-guard.service
    systemctl daemon-reload
    systemctl enable gdfuse-suspend-guard.service > /dev/null
    # The same script used to be dropped here, where both of its halves land
    # in the one window that does not work. Leaving it would run the guard
    # twice, and the late copy finds nothing to abort, which reads as proof
    # the guard is working.
    if [ -e /usr/lib/systemd/system-sleep/gdfuse-suspend-guard ]; then
        rm -f /usr/lib/systemd/system-sleep/gdfuse-suspend-guard
        echo "  gdfuse suspend guard: removed superseded system-sleep hook"
    fi

    hw_model=$(dmidecode -s system-version 2> /dev/null || echo unknown)
    case "$hw_model" in
    'ThinkPad P16 Gen 3')
        # See thinkpad-p16-gen3-ubuntu-suspend.md for the full rationale.
        echo "  $hw_model: applying suspend mitigations"
        reboot_needed=0
        for f in nvidia-s0ix.conf nvidia-resume-speed.conf; do
            if ! cmp -s "$SCRIPT_DIR/system/suspend/p16-gen3/$f" "/etc/modprobe.d/$f"; then
                _install -m 0644 -t /etc/modprobe.d "$SCRIPT_DIR/system/suspend/p16-gen3/$f"
                reboot_needed=1
            fi
        done
        _install -m 0755 -t /usr/lib/systemd/system-sleep \
            "$SCRIPT_DIR"/system/suspend/p16-gen3/igc-ptm-workaround
        # Skip the grub drop-in if the i915 params are already configured
        # (e.g. hand-edited into /etc/default/grub) to avoid duplicates.
        if ! grep -qs 'i915\.enable_psr=0' /etc/default/grub /etc/default/grub.d/*.cfg; then
            _install -m 0644 -t /etc/default/grub.d \
                "$SCRIPT_DIR"/system/suspend/p16-gen3/i915-suspend.cfg
            reboot_needed=1
        fi
        if [ "$reboot_needed" -eq 1 ]; then
            update-initramfs -u
            update-grub
            echo "  NOTE: nvidia/i915 suspend mitigations changed; reboot to apply."
        fi
        echo "  NOTE: failure mode 4 is fixed by the $GDFUSE_VERSION google-drive-ocamlfuse"
        echo "        built in the section above."
        ;;
    'ThinkPad T16 Gen 4')
        # amdgpu suspend/resume is healthy on this hardware; the gdfuse guard
        # above covers its only observed suspend failure. See
        # thinkpad-t16-gen4-ubuntu-suspend.md.
        echo "  $hw_model: no hardware-specific mitigations needed"
        ;;
    *)
        echo "  $hw_model: no hardware-specific suspend mitigations known"
        ;;
    esac
fi

# =============================================================================
banner "Boot display (HiDPI)"
# =============================================================================

# GRUB and Plymouth (including the disk-decryption prompt) render at the
# panel's native resolution; on a HiDPI panel the default 16 px GRUB font
# and Plymouth's 1x UI are unreadably small. Per-model, since the right
# scale is a property of the panel. Sources live in system/hidpi-boot/.
if in_wsl; then
    echo "  Boot display: skipped (WSL)"
else
    hw_model=$(dmidecode -s system-version 2> /dev/null || echo unknown)
    case "$hw_model" in
    'ThinkPad P16 Gen 3') # 3840x2400 eDP, ~260 DPI
        echo "  $hw_model: 32 px GRUB font + Plymouth DeviceScale=2"
        grub_refresh=0
        if [ ! -e /boot/grub/fonts/DejaVuSansMono-32.pf2 ]; then
            _mkdir -p /boot/grub/fonts
            grub-mkfont -s 32 -o /boot/grub/fonts/DejaVuSansMono-32.pf2 \
                /usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf
            grub_refresh=1
        fi
        if ! cmp -s "$SCRIPT_DIR"/system/hidpi-boot/hidpi-grub-font.cfg \
            /etc/default/grub.d/hidpi-grub-font.cfg; then
            _install -m 0644 -t /etc/default/grub.d \
                "$SCRIPT_DIR"/system/hidpi-boot/hidpi-grub-font.cfg
            grub_refresh=1
        fi
        if [ "$grub_refresh" -eq 1 ]; then
            update-grub
        fi
        if ! cmp -s "$SCRIPT_DIR"/system/hidpi-boot/plymouthd.conf \
            /etc/plymouth/plymouthd.conf; then
            _install -m 0644 "$SCRIPT_DIR"/system/hidpi-boot/plymouthd.conf \
                /etc/plymouth/plymouthd.conf
            update-initramfs -u
        fi
        ;;
    *)
        echo "  $hw_model: no HiDPI boot tweaks known"
        ;;
    esac
fi

# =============================================================================
banner "Journal hygiene"
# =============================================================================

# Route the chattiest desktop loggers into their own size-capped log files
# so `journalctl` stays readable; sources live in system/journal-hygiene/.
if in_wsl; then
    echo "  Journal hygiene: skipped (WSL)"
else
    echo "  journald: 20G persistent cap + flood backstop"
    _install -m 0644 -D "$SCRIPT_DIR"/system/journal-hygiene/99-journal-hygiene.conf \
        /etc/systemd/journald.conf.d/99-journal-hygiene.conf
    systemctl restart systemd-journald

    echo "  logrotate: hourly timer override (size caps bite within ~1h)"
    _install -m 0644 -D "$SCRIPT_DIR"/system/journal-hygiene/logrotate-frequency.conf \
        /etc/systemd/system/logrotate.timer.d/frequency.conf
    systemctl daemon-reload

    if systemctl cat tailscaled.service > /dev/null 2>&1; then
        echo "  tailscaled -> /var/log/tailscaled.log"
        _install -m 0644 -D "$SCRIPT_DIR"/system/journal-hygiene/tailscaled-suppress-journal-spam.conf \
            /etc/systemd/system/tailscaled.service.d/suppress-journal-spam.conf
        _install -m 0644 "$SCRIPT_DIR"/system/journal-hygiene/logrotate-tailscaled \
            /etc/logrotate.d/tailscaled
        systemctl daemon-reload
        systemctl try-restart tailscaled.service
    else
        echo "  tailscaled: not installed, skipping"
    fi

    if command -v slack > /dev/null; then
        echo "  Slack -> ~/.local/state/slack/slack.log (on next Slack launch)"
        installUser "$USER_HOME"/.local/bin "$SCRIPT_DIR"/system/journal-hygiene/slack-logged
        installUser "$USER_HOME"/.local/share/applications
        sed "s|^Exec=/usr/bin/slack|Exec=$USER_HOME/.local/bin/slack-logged|" \
            /usr/share/applications/slack.desktop \
            > "$USER_HOME"/.local/share/applications/slack.desktop
        _chown "$SUDO_USER:$SUDO_USER" "$USER_HOME"/.local/share/applications/slack.desktop
        # GIO serves scheme-handler lists from each dir's mimeinfo.cache, and
        # the override masks the system slack.desktop's cache entry. Without
        # regenerating the user dir's cache, no app claims slack:// URLs and
        # the browser-to-app redirect dialog comes up empty.
        sudo -u "$SUDO_USER" -- update-desktop-database "$USER_HOME"/.local/share/applications
        sed "s|@USER@|$SUDO_USER|g; s|@USER_HOME@|$USER_HOME|g" \
            "$SCRIPT_DIR"/system/journal-hygiene/logrotate-slack.in > /etc/logrotate.d/slack
    else
        echo "  Slack: not installed, skipping"
    fi

    if [ -e /usr/lib/systemd/user/localsearch-3.service ]; then
        echo "  LocalSearch -> ~/.local/state/localsearch/localsearch.log"
        # The drop-in's append: target dir must exist before the unit starts
        installUser "$USER_HOME"/.local/state/localsearch
        installUser "$USER_HOME"/.config/systemd/user/localsearch-3.service.d \
            "$SCRIPT_DIR"/system/journal-hygiene/localsearch-suppress-journal-spam.conf
        sed "s|@USER@|$SUDO_USER|g; s|@USER_HOME@|$USER_HOME|g" \
            "$SCRIPT_DIR"/system/journal-hygiene/logrotate-localsearch.in > /etc/logrotate.d/localsearch
        systemctl --user --machine="$SUDO_USER@.host" daemon-reload || true
        systemctl --user --machine="$SUDO_USER@.host" try-restart localsearch-3.service || true
        # Keep the indexer out of network-FUSE mounts under $HOME: gdfuse
        # serves incomplete GIO metadata (steady GLib warnings), and an
        # indexer read in flight when the network drops leaves an
        # unfreezable D-state task that wedges suspend (see the machine
        # suspend docs). Entries are basename globs — absolute paths are
        # NOT matched — so this excludes any directory named 'mnt'.
        if command -v gsettings > /dev/null; then
            gsettings_set org.freedesktop.Tracker3.Miner.Files ignored-directories \
                "['po', 'CVS', 'core-dumps', 'lost+found', 'mnt']"
        fi
    else
        echo "  LocalSearch: not installed, skipping"
    fi
fi

# =============================================================================
banner "Finalizing"
# =============================================================================

echo "  Cleaning up unused packages..."
_apt_get autoremove -y

declare -r PATH_SETTINGS_BANNER='# PATH Additions'
if [ -e "$USER_RC" ] && grep -q -F "$PATH_SETTINGS_BANNER" "$USER_RC"; then
    echo "  Shell paths/prompt: already configured"
else
    echo "  Shell paths/prompt: configuring"
    cat "$SCRIPT_DIR"/dotfiles/dedup_paths.sh >> "$USER_RC"
    (
        echo "$PATH_SETTINGS_BANNER"
        echo 'export GOPATH=$HOME/go'
        echo
        for addition in "${path_additions[@]}"; do
            echo "prepend_path $addition"
        done
        echo
        echo 'dedup_paths'
        echo
        echo "PS1='\w$ '"
        echo
        echo 'eval "$(direnv hook bash)"'
        echo 'eval "$(starship init bash)"'
    ) >> "$USER_RC"
    _chown "$SUDO_USER:$SUDO_USER" -R "$USER_HOME"/.bashrc
    installUser "$USER_HOME"/.config "$SCRIPT_DIR"/dotfiles/starship.toml
fi

echo
echo "Done!"

# gdfuse OAuth is the one step provision cannot do: it needs a browser and
# the user's Google account. Print the recipe until it has been completed.
if [ ! -e "$USER_HOME/.gdfuse/default/state" ]; then
    cat << EOF

NOTE: google-drive-ocamlfuse is installed and ~/GoogleDrive will auto-mount
      at login, but Google Drive authorization has not been done yet
      (no ~/.gdfuse/default/state). One-time setup, as $SUDO_USER:
        1. In https://console.cloud.google.com/ create (or pick) a project,
           enable the Google Drive API (APIs & Services -> Library), then
           create an OAuth client ID of type "Desktop app"
           (APIs & Services -> Credentials -> Create credentials).
        2. Hand the client ID + secret to gdfuse and authorize in a browser:
             google-drive-ocamlfuse -headless -label default \\
                 -id <CLIENT_ID>.apps.googleusercontent.com -secret <CLIENT_SECRET>
           (the values live in ~/.gdfuse/default/config as client_id /
           client_secret should you ever need to edit them)
        3. Mount now (or just log out and back in):
             systemctl --user start $GDFUSE_UNIT
EOF
fi
